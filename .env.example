# Local development defaults.
#
# Copy this to .env for local work. It is NOT the production config: the build
# script writes .webslice/env.production instead, and real environment variables
# set in the Webslice Console take precedence over both. See README.md.

APP_NAME="Statamic Starter"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://statamic-starter.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Nothing in this starter reads from a database. Statamic stores content, users
# and form submissions as flat files. Leave this alone unless you add something
# that genuinely needs one, and read the database notes in docs/how-it-works.md
# SQLite in particular does not belong on Webslice.
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

STATAMIC_LICENSE_KEY=
STATAMIC_PRO_ENABLED=false

# Watches content files and rebuilds the Stache as you edit. Worth having
# locally, and switched off in production where files only change on deploy.
STATAMIC_STACHE_WATCHER=auto

# Left off locally so you see your edits immediately. Production uses "full".
STATAMIC_STATIC_CACHING_STRATEGY=null

STATAMIC_TWO_FACTOR_ENABLED=true
STATAMIC_REVISIONS_ENABLED=false
STATAMIC_GRAPHQL_ENABLED=false
STATAMIC_API_ENABLED=false
STATAMIC_GIT_ENABLED=false

DEBUGBAR_ENABLED=false
