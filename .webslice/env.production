# Production baseline, copied to .env by .webslice/build.sh on every deploy, so
# a deploy never inherits the local defaults in .env.example.
#
# Env Vars set in the Webslice Console are real environment variables and win
# over every line here, because Laravel never overwrites a variable that is
# already set. Put secrets there. This file is committed to git.
#
# Set this in the Console, not here:
#   APP_URL  the full live URL including https://. A bare domain silently
#            resolves to http://localhost and breaks every generated link.
#
# APP_KEY is optional. The build generates one on the first deploy that has
# none and keeps it in /mnt/data/website/shared, so it stays the same after
# that. Set it in the Console to hold the key yourself: run
# `php artisan key:generate --show` on your own machine and paste the value in,
# since there is no shell on the platform to run it there.

APP_ENV=production
APP_DEBUG=false

# Empty on purpose, and the line has to stay: the build fills it in, and both
# key:generate and the shared storage fallback only rewrite an existing line.
APP_KEY=

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# The provider sets both of these at runtime. They are the fallback if it is
# ever switched off with DISABLE_WEBSLICE_PROVIDER.
CACHE_STORE=file
SESSION_DRIVER=cookie

MAIL_MAILER=log

STATAMIC_PRO_ENABLED=false

# Content only changes on deploy, so watching for edits is a wasted filesystem
# scan on every request.
STATAMIC_STACHE_WATCHER=false

# Writes rendered HTML to public/static, which Apache serves without booting
# PHP via the rules in public/.htaccess.
STATAMIC_STATIC_CACHING_STRATEGY=full

STATAMIC_TWO_FACTOR_ENABLED=true
STATAMIC_REVISIONS_ENABLED=false
STATAMIC_GRAPHQL_ENABLED=false
STATAMIC_API_ENABLED=false
STATAMIC_GIT_ENABLED=false

DEBUGBAR_ENABLED=false
